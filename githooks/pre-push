#!/bin/sh
# Review gate: refuse to push commits that have not passed code review.
#
# The /feature workflow records a passing code-critic run by writing the
# reviewed commit SHA to .review-passed (gitignored, one per worktree) via
# scripts/review-ok.sh. Any commit made after the review moves HEAD away from
# the marker, so post-review changes cannot be pushed without a re-review.
#
# One-time setup per clone (shared by all worktrees):
#     git config core.hooksPath githooks
#
# Human bypass: git push --no-verify   or   SKIP_REVIEW_GATE=1 git push
#
# Note: pushing an ANNOTATED tag always blocks — the hook sees the tag
# object's SHA, which can never equal the reviewed commit SHA. Use
# --no-verify when pushing release tags.

[ "$SKIP_REVIEW_GATE" = "1" ] && exit 0

marker="$(git rev-parse --show-toplevel)/.review-passed"
reviewed=""
[ -f "$marker" ] && reviewed="$(cat "$marker")"

zero=0000000000000000000000000000000000000000
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch deletions push the zero SHA — nothing to review.
    [ "$local_sha" = "$zero" ] && continue
    if [ "$local_sha" != "$reviewed" ]; then
        echo "pre-push: BLOCKED — $local_ref ($local_sha) does not match the last reviewed commit." >&2
        blocked=1
    fi
done

if [ "$blocked" -ne 0 ]; then
    echo "" >&2
    echo "The commit being pushed has not passed code review (Rule 4)." >&2
    echo "  1. Run the code-critic sub-agent (or /code-critic) on the committed state." >&2
    echo "  2. After it passes with no FAIL items, record it: scripts/review-ok.sh" >&2
    echo "  3. Push again." >&2
    echo "Human bypass: git push --no-verify" >&2
fi
exit "$blocked"
